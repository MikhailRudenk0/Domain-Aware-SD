     def forward(self, x, seq_len=None):
         # x: [bs, num_attention_heads, seq_len, head_size]
+        # transformers >= 5 loads remote-code models through a meta-device path
+        # that never materializes non-persistent buffers, so inv_freq and the
+        # cos/sin caches computed in __init__ contain uninitialized garbage
+        # after from_pretrained. Rebuild them on first real forward.
+        if not getattr(self, "_rope_materialized", False):
+            inv_freq = 1.0 / (
+                self.base ** (torch.arange(0, self.dim, 2, dtype=torch.int64, device=x.device).float() / self.dim)
+            )
+            self.register_buffer("inv_freq", inv_freq, persistent=False)
+            self._set_cos_sin_cache(
+                seq_len=max(self.max_position_embeddings, seq_len or 0), device=x.device, dtype=x.dtype
+            )
+            self._rope_materialized = True
         if seq_len > self.max_seq_len_cached:
             self._set_cos_sin_cache(seq_len=seq_len, device=x.device, dtype=x.dtype)
 
